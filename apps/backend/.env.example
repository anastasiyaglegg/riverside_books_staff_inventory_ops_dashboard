# Supabase Postgres connection (transaction pooler, port 6543) -- used by the app at
# runtime. MUST end in ?pgbouncer=true or Prisma's prepared statements collide across
# pooled connections ("prepared statement \"s0\" already exists").
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Postgres connection used only for Prisma migrations. The true "direct"
# connection (db.<project-ref>.supabase.co:5432) is IPv6-only; on an IPv4-only network,
# use the session pooler (same host as above, port 5432) instead.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never expose to a frontend.
SUPABASE_SERVICE_ROLE_KEY=
