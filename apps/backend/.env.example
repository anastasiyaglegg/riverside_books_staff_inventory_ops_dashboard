# Supabase Postgres connection (transaction pooler, port 6543) -- used by the app at
# runtime. MUST end in ?pgbouncer=true or Prisma's prepared statements collide across
# pooled connections ("prepared statement \"s0\" already exists").
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Postgres connection used only for Prisma migrations. The true "direct"
# connection (db.<project-ref>.supabase.co:5432) is IPv6-only; on an IPv4-only network,
# use the session pooler (same host as above, port 5432) instead.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never expose to a frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin service account for verifying customer ID tokens (Product A auth).
# The full service-account JSON, single-line, from Firebase console -> Project settings
# -> Service accounts -> Generate new private key. Backend only -- never expose this.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Stripe (Product A cart checkout). Backend only -- never expose. Prefer a restricted
# test key (rk_test_...) over the full secret (sk_test_...). Get them from
# dashboard.stripe.com (test mode) -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Signing secret for the payment webhook. Locally, run `stripe listen --forward-to
# localhost:3000/api/v1/webhooks/stripe` and copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the browser after embedded checkout (the customer app origin).
FRONTEND_ORIGIN=http://localhost:5173
