// Source of truth for the shared Riverside Books schema (backend + staff-dashboard
// scope only -- see CLAUDE.md "Database Schema"). Any change needs a migration,
// never a hand edit against Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Book {
  id          String      @id @default(uuid())
  title       String
  author      String
  isbn        String?     @unique
  priceCents  Int         @map("price_cents")
  category    String?
  description String?
  imageUrl    String?     @map("image_url")
  // Staff-entered average rating, 0-5. Null until a staff member sets one --
  // never fabricated (see lib/marketing/catalog-mapper.ts, which skips a book
  // for Product D generation while this is null rather than invent a value).
  rating      Float?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  inventory   Inventory?
  orderItems  OrderItem[]
  marketingContent BookMarketingContent?

  @@map("books")
}

// The most recently generated Product D marketing draft for a book -- one row per book
// (regenerating overwrites it), populated by POST /marketing/generate and read publicly
// via GET /books/:id so the customer app can display it. Mirrors
// riverside_marketing.generation.drafts.MarketingDraft.as_dict() in apps/content-generator.
model BookMarketingContent {
  id           String   @id @default(uuid())
  bookId       String   @unique @map("book_id")
  book         Book     @relation(fields: [bookId], references: [id])
  contentType  String   @map("content_type")
  headline     String
  bodyCopy     String   @map("body_copy")
  reason       String
  sourceFields String[] @map("source_fields")
  generatedAt  DateTime @default(now()) @map("generated_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("book_marketing_content")
}

model Inventory {
  id               String     @id @default(uuid())
  bookId           String     @unique @map("book_id")
  book             Book       @relation(fields: [bookId], references: [id])
  quantityOnHand   Int        @map("quantity_on_hand")
  reorderThreshold Int        @default(2) @map("reorder_threshold")
  // "in_stock" | "low_stock" | "out_of_stock" -- derived via deriveStockStatus(), never hand-set.
  status           String
  // Story B3: "change is attributed to the staff user and timestamped" -- updatedAt
  // covers the timestamp, this covers the attribution. Set on every PATCH, never on create.
  lastAdjustedById String?    @map("last_adjusted_by_id")
  lastAdjustedBy   StaffUser? @relation(fields: [lastAdjustedById], references: [id])
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("inventory")
}

// Non-book merchandise the store also sells. Kept as its own table (not merged into
// Book) so it carries no book-only fields like author/isbn. Stock is tracked inline
// via quantityOnHand rather than the separate Inventory table -- gifts don't need the
// reorder-threshold/status derivation books have. Money is integer cents, same rule.
model Gift {
  id             String   @id @default(uuid())
  name           String
  priceCents     Int      @map("price_cents")
  // Free-form grouping, e.g. "mug" | "tote" | "stationery" | "puzzle".
  category       String?
  description    String?
  imageUrl       String?  @map("image_url")
  quantityOnHand Int         @default(0) @map("quantity_on_hand")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orderItems     OrderItem[]

  @@map("gifts")
}

// Greeting cards -- separate from Gift so card-specific grouping (occasion) stays
// distinct. Same inline-stock, integer-cents conventions as Gift.
model Card {
  id             String   @id @default(uuid())
  title          String
  priceCents     Int      @map("price_cents")
  // Occasion, e.g. "birthday" | "thank-you" | "holiday" | "sympathy" | "blank".
  occasion       String?
  description    String?
  imageUrl       String?  @map("image_url")
  quantityOnHand Int         @default(0) @map("quantity_on_hand")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orderItems     OrderItem[]

  @@map("cards")
}

model Customer {
  id                String               @id @default(uuid())
  firstName         String               @map("first_name")
  // Optional: guest-checkout and one-name customers may only have a first name; the
  // signup form + POST /customers require both, but the column stays nullable so those
  // paths (and legacy rows) remain valid.
  lastName          String?              @map("last_name")
  email             String?              @unique
  phone             String?              @unique
  // Firebase Auth uid (customer sign-in, Product A). Nullable because staff-created and
  // guest-checkout customers predate/skip Firebase; unique so one uid maps to one row.
  firebaseUid       String?              @unique @map("firebase_uid")
  loyaltyStampCount Int                  @default(0) @map("loyalty_stamp_count")
  createdAt         DateTime             @default(now()) @map("created_at")
  orders            Order[]
  loyaltyTx         LoyaltyTransaction[]
  eventTickets      EventTicket[]

  @@map("customers")
}

model Order {
  id            String      @id @default(uuid())
  customerId    String      @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  // "placed" | "ready_for_pickup" | "completed" | "cancelled"
  status        String
  // "unpaid" | "paid_online" | "pay_in_store"
  paymentStatus String      @map("payment_status")
  totalCents    Int         @map("total_cents")
  // Stripe Checkout Session id for online-paid orders. Unique so the payment webhook is
  // idempotent -- Stripe may deliver checkout.session.completed more than once, and this
  // stops a duplicate order. Null for in-store / non-Stripe orders.
  stripeSessionId String?   @unique @map("stripe_session_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  order          Order   @relation(fields: [orderId], references: [id])
  // An order line references exactly one product, from any of the three catalogs
  // (books, gifts, cards). Exactly one of bookId/giftId/cardId is non-null -- enforced
  // by a CHECK constraint in the migration, since Prisma can't model "exactly one of".
  // unitPriceCents snapshots the price at order time regardless of product type.
  bookId         String? @map("book_id")
  book           Book?   @relation(fields: [bookId], references: [id])
  giftId         String? @map("gift_id")
  gift           Gift?   @relation(fields: [giftId], references: [id])
  cardId         String? @map("card_id")
  card           Card?   @relation(fields: [cardId], references: [id])
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")

  @@map("order_items")
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime      @map("event_date")
  capacity    Int?
  createdAt   DateTime      @default(now()) @map("created_at")
  tickets     EventTicket[]

  @@map("events")
}

model EventTicket {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id])
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  // "reserved" | "attended" | "cancelled"
  status     String   @default("reserved")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("event_tickets")
}

model LoyaltyTransaction {
  id             String   @id @default(uuid())
  customerId     String   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id])
  // "earn" | "redeem"
  type           String
  relatedOrderId String?  @map("related_order_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("loyalty_transactions")
}

model StorePolicy {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_policies")
}

model StaffUser {
  id                String      @id @default(uuid()) // matches Supabase Auth user id
  name              String
  // "owner" | "bookseller"
  role              String
  adjustedInventory Inventory[]

  @@map("staff_users")
}
