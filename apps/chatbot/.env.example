# Supabase (Postgres) — service role key is server-side only, never expose in client bundle
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string (Project Settings -> Database -> Connection string,
# "URI" tab, with the password filled in). Only needed to run `npm run migrate` programmatically.
# If omitted, apply schema/migrations/*.sql by hand in the Supabase SQL Editor instead.
DATABASE_URL=

# Anthropic Claude — server-side only
ANTHROPIC_API_KEY=

# Firebase Authentication (optional identity — chat works anonymously without this)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Product A deep-link target for "Reserve for pickup"
# Placeholder until Product A's real reservation URL exists.
NEXT_PUBLIC_PRODUCT_A_URL=https://product-a.riversidebooks.example/reserve
