# Public value only -- this is a browser-shipped SPA, never put a service role
# key or any backend-only secret in this app.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Firebase web config. These are ALSO public browser values -- a Firebase web config
# identifies the project, it is not a secret (security is enforced by Firebase Auth
# settings + rules). Copy them from Firebase console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe publishable key (test mode). Public/browser-safe -- it only identifies the
# account; the secret key lives in the backend. From dashboard.stripe.com (test mode)
# -> Developers -> API keys.
VITE_STRIPE_PUBLISHABLE_KEY=
